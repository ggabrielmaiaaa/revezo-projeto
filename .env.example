# Copie para .env.local e preencha. Nunca faça commit do .env.local.

# Supabase (etapa 2) — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Só no servidor. Nunca use em código de cliente.
SUPABASE_SERVICE_ROLE_KEY=

# TMDB (etapa 4) — token de leitura da API v4. Só no servidor.
TMDB_READ_TOKEN=

# Resend (etapa 6)
RESEND_API_KEY=
EMAIL_FROM="Revezo <avisos@seu-dominio.com>"

# Web Push (etapa 6) — gere com: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@seu-dominio.com

# Cron (etapa 6) — um valor aleatório longo
CRON_SECRET=
